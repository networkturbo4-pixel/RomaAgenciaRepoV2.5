# 1. Prohibir el listado de directorios
Options -Indexes

# 2. Cabeceras de seguridad HTTP
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 3. Bloquear archivos y extensiones confidenciales
<FilesMatch "(?i)\.(sql|env|log|git|bak|backup|ini|sh|md|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^(composer\.json|composer\.lock|notas_migracion\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear acceso a carpetas de control de versiones y tokens
    RewriteRule ^\.git - [F,L]
    RewriteRule ^whatsapp_service/tokens - [F,L]
    RewriteRule ^scratch - [F,L]

    # Ignorar archivos o carpetas reales
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Sitemap
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Ruta amigable corta para cotizaciones: /c/TOKEN o /cotizacion/TOKEN
    RewriteRule ^c/([^/]+)/?$ index.php?module=quotes&action=public&token=$1 [QSA,L]
    RewriteRule ^cotizacion/([^/]+)/?$ index.php?module=quotes&action=public&token=$1 [QSA,L]

    # Ruta amigable corta para formularios: /f/TOKEN o /form/TOKEN
    RewriteRule ^f/([^/]+)/?$ index.php?module=forms&action=fill&token=$1 [QSA,L]
    RewriteRule ^form/([^/]+)/?$ index.php?module=forms&action=fill&token=$1 [QSA,L]

    # Ruta amigable corta para notas de pago: /np/TOKEN o /nota/TOKEN
    RewriteRule ^np/([^/]+)/?$ index.php?module=admin&action=payment_note_webview&view=public&token=$1 [QSA,L]
    RewriteRule ^nota/([^/]+)/?$ index.php?module=admin&action=payment_note_webview&view=public&token=$1 [QSA,L]

    # Ruta amigable para chat de invitados: /m/TOKEN
    RewriteRule ^m/([^/]+)/?$ index.php?module=mensajes&action=guest&token=$1 [QSA,L]

    # Ruta amigable para un servicio especifico: /servicio/22/slug
    RewriteRule ^servicio/([0-9]+)/([^/]+)/?$ index.php?module=public&action=service&id=$1&slug=$2 [QSA,L]

    # Ruta amigable para un servicio especifico sin slug: /servicio/22
    RewriteRule ^servicio/([0-9]+)/?$ index.php?module=public&action=service&id=$1 [QSA,L]

    # Ruta amigable para el catalogo: /catalogo
    RewriteRule ^catalogo/?$ index.php?module=public&action=catalog [QSA,L]

    # Ruta amigable para linktree (BioLinks): /l/slug
    RewriteRule ^l/([^/]+)/?$ index.php?module=public&action=linktree&slug=$1 [QSA,L]

</IfModule>
