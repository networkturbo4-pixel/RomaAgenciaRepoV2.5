# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - ROMA SAAS
# ==============================================================================
# Copie este archivo como .env y complete sus credenciales reales.
# IMPORTANTE: Nunca suba el archivo .env a repositorios de control de versiones.

# Entorno: 'local' o 'production'
APP_ENV=production
APP_URL=https://tudominio.com

# Clave secreta del sistema (para firmas criptográficas y tokens seguros HMAC)
# Genere una cadena aleatoria única de al menos 32 caracteres
APP_SECRET=cambiar_por_una_clave_secreta_aleatoria_muy_larga_y_segura

# Credenciales de Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=saas_cesar_db
DB_USER=root
DB_PASS=

# Notificaciones y Servicios Opcionales
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=
